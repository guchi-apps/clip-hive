# アプリ実行時に参照する環境変数（値は空。ローカルは .env.local.example を参照）
DATABASE_URL=
AUTH_URL=
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAIL=

# ログイン通知（任意。未設定なら通知しない）
SIGNALY_LOGIN_WEBHOOK_URL=

# 保存先ドライバ: LOCAL または S3
STORAGE_DRIVER=LOCAL
STORAGE_LOCAL_DIR=
STORAGE_QUOTA_GB=20

# STORAGE_DRIVER=S3 のときのみ使用
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=

# デプロイ時のみ使用（DATABASE_URL の組み立て元。scripts/construct-database-url.sh）
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_NAME=

# CI/デプロイ通知
SIGNALY_WEBHOOK_URL=
