# アプリ実行時に参照する環境変数（値は空。ローカルは .env.local.example を参照）
DATABASE_URL=

# 認証: Supabase Auth (Google)。フロントエンドで使うのは publishable key のみで、
# service_role キーはリポジトリにもVPSにも置かない。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ログイン許可はStatusHubの共通アクセス設定で判定する。判定APIのトークンは issue-deck の共有トークン
# CLIP_HIVE_ACCESS_APP_TOKEN から読むため、その接続情報だけを持つ。読めないと全員拒否。
SHARED_TOKEN_API_SECRET=
ISSUE_DECK_URL=

# PWA起動時の簡易PIN認証で使うCookieの署名鍵
AUTH_SECRET=

# ログイン通知（任意。未設定なら通知しない）
SIGNALY_LOGIN_WEBHOOK_URL=

# 保存先ドライバ: LOCAL または S3
STORAGE_DRIVER=LOCAL
STORAGE_LOCAL_DIR=
STORAGE_QUOTA_GB=20

# STORAGE_DRIVER=S3 のときのみ使用
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=

# デプロイ時のみ使用（DATABASE_URL の組み立て元。scripts/construct-database-url.sh）
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_NAME=

# CI/デプロイ通知
SIGNALY_WEBHOOK_URL=
