# cp .env.local.example .env.local
#
# ローカル開発用。1Password は不要（本番はGitHubのsecret / variable経由で注入される）。
#
# 認証は Supabase Auth (Google)。開発用と本番用でSupabaseプロジェクトを分けているため、
# ここには**開発用**プロジェクトの project-url / publishable-key を直接書く
# （1Passwordにも登録されているが、ローカル開発では依存を避けて直接設定する）。
# 開発用Supabaseの Redirect URLs に http://localhost:3000/auth/callback を登録しておくこと。

DATABASE_URL=mysql://clip_hive:devpassword@127.0.0.1:3306/app_clip_hive_dev

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ログインを許可する Google アカウント（カンマ区切り）。未設定なら全員拒否。
ALLOWED_GOOGLE_EMAILS=you@example.com

# PWA起動時の簡易PIN認証で使うCookieの署名鍵（任意の乱数。`openssl rand -base64 32` 等）
AUTH_SECRET=

# ログイン通知（任意。未設定なら通知しない。ローカルでは空のままでよい）
SIGNALY_LOGIN_WEBHOOK_URL=

# LAN上の別端末(スマホ)から開発サーバーを開く場合に許可するオリジン（カンマ区切り）。
# 生のLAN IPではOAuthのリダイレクトが失敗するため sslip.io でホスト名化する。
# 例: DEV_ALLOWED_ORIGINS=**.sslip.io
DEV_ALLOWED_ORIGINS=

# 保存先ドライバ: LOCAL(サーバー保存) または S3(S3互換ストレージ)
STORAGE_DRIVER=LOCAL
# LOCAL 保存時の保存先ディレクトリ(未設定なら ./storage)
STORAGE_LOCAL_DIR=
# 合計保存容量の上限(GB)
STORAGE_QUOTA_GB=20

# STORAGE_DRIVER=S3 のときのみ使用(R2/MinIO等のS3互換ストレージ)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
