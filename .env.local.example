# cp .env.local.example .env.local
#
# ローカル開発用。1Password は不要（本番は .github/deploy.env.tpl 経由で1Passwordから注入）。
# Google OAuth は開発用と本番用でGoogle Cloudのプロジェクト/クライアントを分けること。
#   開発用クライアントの承認済みリダイレクトURI: http://localhost:3000/api/auth/callback/google

DATABASE_URL=mysql://clip_hive:devpassword@127.0.0.1:3306/app_clip_hive_dev

AUTH_URL=http://localhost:3000
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 本人のみログインを許可するメールアドレス
ALLOWED_EMAIL=you@gmail.com

# ログイン通知（任意。未設定なら通知しない。ローカルでは空のままでよい）
SIGNALY_LOGIN_WEBHOOK_URL=

# 保存先ドライバ: LOCAL(サーバー保存) または S3(S3互換ストレージ)
STORAGE_DRIVER=LOCAL
# LOCAL 保存時の保存先ディレクトリ(未設定なら ./storage)
STORAGE_LOCAL_DIR=
# 合計保存容量の上限(GB)
STORAGE_QUOTA_GB=20

# STORAGE_DRIVER=S3 のときのみ使用(R2/MinIO等のS3互換ストレージ)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
